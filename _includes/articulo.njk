---
layout: base.njk
---
{%- set num = collections.numeros | numeroPorId(numero) -%}
{%- set hermanos = collections.articulo | delNumero(numero) -%}
{%- set pos = hermanos | posicion(page.url) -%}
{%- set autoresTxt = autores | listaAutores -%}
<main>
  <article class="articulo">
    <div class="wrap">
      <nav class="migas" aria-label="Ruta"><a href="/colombeia.html">Colombeia</a><span aria-hidden="true"> › </span><a href="{{ num.url }}">N.º {{ numero }} · {{ num.data.fecha }}</a></nav>
      <header class="art-cab">
        <p class="label">{{ seccion }}</p>
        <h1>{{ titulo }}</h1>
        {%- if subtitulo %}<p class="subt">{{ subtitulo }}</p>{% endif %}
        <p class="autores">{% for a in autores %}{{ a }}{% if a | orcid %} <a class="orcid" href="https://orcid.org/{{ a | orcid }}" target="_blank" rel="noopener" aria-label="ORCID de {{ a }}: {{ a | orcid }}"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 256 256"><circle cx="128" cy="128" r="128" fill="#A6CE39"/><path fill="#fff" d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4zM88.7 56.8c0 5.5-4.5 10.1-10.1 10.1s-10.1-4.6-10.1-10.1c0-5.6 4.5-10.1 10.1-10.1s10.1 4.6 10.1 10.1z"/></svg></a>{% endif %}{% if not loop.last %}{% if loop.revindex == 2 %} y {% else %}, {% endif %}{% endif %}{% endfor %}{% if editor %} <span class="ed">(<span class="es">ed.</span><span class="en">ed.</span> {{ editor }})</span>{% endif %}</p>
        <p class="ref"><i>Colombeia</i>, n.º {{ numero }} ({{ num.data.fecha }}), pp. {{ pagina_inicial }}-{{ pagina_final }} · ISSN {{ sitio.issn }}</p>
      </header>
      <div class="art-grid">
        <div class="art-main">
          <section class="resumen">
            <h2 class="label"><span class="es">Resumen</span><span class="en">Abstract (Spanish)</span></h2>
            <p>{{ resumen }}</p>
            {%- if palabras_clave and palabras_clave.length %}
            <p class="kw"><b><span class="es">Palabras clave:</span><span class="en">Keywords:</span></b> {{ palabras_clave | join("; ") }}</p>
            {%- endif %}
          </section>
          {%- if abstract %}
          <section class="resumen" lang="en">
            <h2 class="label">Abstract</h2>
            <p>{{ abstract }}</p>
            {%- if keywords and keywords.length %}
            <p class="kw"><b>Keywords:</b> {{ keywords | join("; ") }}</p>
            {%- endif %}
          </section>
          {%- endif %}
          <section class="lector" data-pdf="{{ pdf }}" aria-label="Lector del artículo">
            <div class="lector-barra">
              <button type="button" class="lb" data-acc="menos" aria-label="Reducir">−</button>
              <button type="button" class="lb" data-acc="ajustar"><span class="es">Ajustar</span><span class="en">Fit</span></button>
              <button type="button" class="lb" data-acc="mas" aria-label="Ampliar">+</button>
              <span class="lector-estado" aria-live="polite"></span>
              <a class="lb" href="{{ pdf }}" download><span class="es">Descargar PDF</span><span class="en">Download PDF</span></a>
            </div>
            <div class="lector-paginas"></div>
            <noscript><p><a href="{{ pdf }}">Abrir el PDF</a></p></noscript>
          </section>
        </div>
        <div class="art-lado">
          <a class="btn" href="{{ pdf }}" download><span class="es">Descargar PDF</span><span class="en">Download PDF</span></a>
          <div>
            <p class="label"><span class="es">Cómo citar</span><span class="en">How to cite</span></p>
            <p class="cita">{{ autoresTxt }}, «{{ titulo }}{% if subtitulo %}: {{ subtitulo }}{% endif %}»{% if editor %}, ed. {{ editor }}{% endif %}, <i>Colombeia</i>, n.º {{ numero }} ({{ num.data.fecha }}): {{ pagina_inicial }}-{{ pagina_final }}.</p>
            <p class="cita-descargas"><a href="/colombeia/citas/{{ page.fileSlug }}.ris" download>RIS</a><a href="/colombeia/citas/{{ page.fileSlug }}.bib" download>BibTeX</a></p>
          </div>
          {%- set cTitulo = titulo + (": " + subtitulo if subtitulo else "") %}{% set cUrl = sitio.url + (page.url | urlLimpia) %}
          {% include "compartir.njk" %}
          {%- if doi %}
          <div><p class="label">DOI</p><p><a href="https://doi.org/{{ doi }}" target="_blank" rel="noopener">{{ doi }}</a></p></div>
          {%- endif %}
          {%- if licencia %}
          <div><p class="label"><span class="es">Licencia</span><span class="en">License</span></p><p>{% if licencia == "CC BY 4.0" %}<a href="https://creativecommons.org/licenses/by/4.0/deed.es" target="_blank" rel="noopener">Creative Commons Atribución 4.0 (CC BY 4.0)</a>{% else %}{{ licencia }}{% endif %}</p></div>
          {%- endif %}
          <nav class="art-nav" aria-label="Otros textos del número">
            {%- if pos.anterior %}<a href="{{ pos.anterior.url }}"><span class="label"><span class="es">Anterior</span><span class="en">Previous</span></span>{{ pos.anterior.data.titulo }}</a>{% endif %}
            {%- if pos.siguiente %}<a href="{{ pos.siguiente.url }}"><span class="label"><span class="es">Siguiente</span><span class="en">Next</span></span>{{ pos.siguiente.data.titulo }}</a>{% endif %}
          </nav>
        </div>
      </div>
      {%- for ab in autores | obrasDeAutores(catalogo) %}
      <section class="art-biblioteca" aria-labelledby="ab-{{ ab.slug }}">
        <h2 id="ab-{{ ab.slug }}" class="label"><span class="es">{{ ab.nombre }} en la Biblioteca Digital</span><span class="en">{{ ab.nombre }} in the Digital Library</span></h2>
        {%- set lista = ab.obras.slice(0, 6) %}{% set clase = "portadas-recientes" %}{% set oculta = false %}
        {% include "portadas-grid.njk" %}
        <a class="more" href="/biblioteca/autores/{{ ab.slug }}/"><span class="es">{{ "Ver la obra" if ab.obras.length == 1 else "Ver las " + ab.obras.length + " obras" }} del autor</span><span class="en">{{ "See the work" if ab.obras.length == 1 else "See all " + ab.obras.length + " works" }} by this author</span></a>
      </section>
      {%- endfor %}
    </div>
  </article>
</main>
