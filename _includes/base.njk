<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}</title>
{% include "metas-sociales.njk" %}
<link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="Idearium Caribe · Novedades de la Biblioteca Digital" href="/biblioteca/novedades.xml">
<link rel="alternate" type="application/rss+xml" title="Colombeia" href="/colombeia/rss.xml">
<link rel="preload" href="/assets/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/fuentes.css?v={{ version }}">
<link rel="stylesheet" href="/assets/estilo.css?v={{ version }}">
{% if esArticulo %}{% include "metas-articulo.njk" %}{% endif %}
{% if obra and obra.identificador %}{% include "metas-obra.njk" %}{% endif %}
</head>
<body>
<a class="saltar" href="#contenido"><span class="es">Saltar al contenido</span><span class="en">Skip to content</span></a>
{%- set u = page.url %}
<header class="top">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="seal">{% include "logo.svg" %}</span>
      <b>Idearium Caribe</b>
    </a>
    <nav class="menu" aria-label="Menú principal">
      <a href="/fundacion.html"{% if u == "/fundacion.html" %} aria-current="page"{% endif %}><span class="es">La Fundación</span><span class="en">The Foundation</span></a>
      <a href="/biblioteca.html"{% if u.startsWith("/biblioteca") %} aria-current="page"{% endif %}><span class="es">Biblioteca</span><span class="en">Library</span></a>
      <a href="/colombeia.html"{% if u.startsWith("/colombeia") %} aria-current="page"{% endif %}>Colombeia</a>
      <a href="/el-caribe-ilustrado.html"{% if u == "/el-caribe-ilustrado.html" %} aria-current="page"{% endif %}>El Caribe Ilustrado</a>
      <a href="/apoyanos.html"{% if u == "/apoyanos.html" %} aria-current="page"{% endif %}><span class="es">Apóyanos</span><span class="en">Support us</span></a>
      <a href="/buscar.html" class="menu-buscar"{% if u == "/buscar.html" %} aria-current="page"{% endif %}><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><span class="es">Buscar</span><span class="en">Search</span></a>
    </nav>
    <div class="langs" role="group" aria-label="Idioma / Language">
      <button type="button" id="lang-es" data-lang="es" aria-pressed="true">ES</button>
      <button type="button" id="lang-en" data-lang="en" aria-pressed="false">EN</button>
    </div>
  </div>
</header>
<span id="contenido" tabindex="-1"></span>

{%- set excluidas = ["/biblioteca/catalogo/", "/biblioteca/autores/", "/biblioteca/materias/", "/404.html", "/buscar.html"] %}
{%- if buscable === false or (page.url in excluidas) or not page.url.endsWith("/") and not page.url.endsWith(".html") %}
{{ content | safe }}
{%- else %}
{%- if obra and obra.identificador %}{% set tipoBusqueda = "Obra" %}{% elif esArticulo %}{% set tipoBusqueda = "Colombeia" %}{% elif page.url.startsWith("/biblioteca/autores/") %}{% set tipoBusqueda = "Autor" %}{% elif page.url.startsWith("/biblioteca/materias/") %}{% set tipoBusqueda = "Tema" %}{% elif page.url.startsWith("/colombeia/") %}{% set tipoBusqueda = "Colombeia" %}{% else %}{% set tipoBusqueda = "Página" %}{% endif %}
<div data-pagefind-body>
<span hidden data-pagefind-filter="tipo:{{ tipoBusqueda }}"></span>
{%- if obra and obra.identificador %}<span hidden data-pagefind-meta="image:{{ obra | portada }}"></span><span hidden data-pagefind-meta="image_alt:Portada"></span>{% endif %}
{{ content | safe }}
</div>
{%- endif %}

<p class="solo-impresion">{{ sitio.nombre }} · {% if obra and obra.identificador and sitio.naan %}https://n2t.net/ark:{{ sitio.naan }}/{{ obra.signatura }}{% else %}{{ sitio.url }}{{ page.url | urlLimpia }}{% endif %}</p>
<a href="#" class="arriba" id="arriba" aria-label="Volver arriba" hidden><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a>
<footer>
  <div class="wrap">
    <div>
      <span class="seal">{% include "logo.svg" %}</span>
      <div class="addr">
        <span>{{ sitio.nombre }}</span>
        <span>{{ sitio.direccion }}</span>
        <span><span id="email">{{ sitio.email }}</span><button type="button" class="copy" id="copy-email"><span class="es">Copiar</span><span class="en">Copy</span></button><span class="copy-status" id="copy-status" role="status"></span></span>
      </div>
    </div>
    <div><h2 class="es">La Fundación</h2><h2 class="en">Foundation</h2>
      <ul><li><a href="/fundacion.html"><span class="es">Quiénes somos</span><span class="en">Who we are</span></a></li>
        <li><a href="/biblioteca.html#acceso"><span class="es">Acceso y derechos</span><span class="en">Access and rights</span></a></li>
        <li><a href="/apoyanos.html"><span class="es">Apóyanos</span><span class="en">Support us</span></a></li></ul></div>
    <div><h2 class="es">Publicaciones</h2><h2 class="en">Publications</h2>
      <ul><li><a href="/biblioteca/catalogo/"><span class="es">Biblioteca Digital</span><span class="en">Digital Library</span></a></li>
        <li><a href="/colombeia.html">Colombeia</a></li>
        <li><a href="/el-caribe-ilustrado.html">El Caribe Ilustrado</a></li></ul></div>
    <div><h2 class="es">Síguenos</h2><h2 class="en">Follow us</h2>
      <ul>{% for r in sitio.redes_sociales %}<li><a href="{{ r.enlace }}" target="_blank" rel="noopener">{{ r.nombre }}</a></li>{% endfor %}</ul></div>
    <div><h2 class="es">Redes académicas</h2><h2 class="en">Scholarly networks</h2>
      <ul>{% for r in sitio.redes_academicas %}<li><a href="{{ r.enlace }}" target="_blank" rel="noopener">{{ r.nombre }}</a></li>{% endfor %}</ul></div>
    <div class="legal">
      <span>© {{ anio_actual }} {{ sitio.nombre }} · Colombeia ISSN {{ sitio.issn }} · <a href="/aviso-legal.html"><span class="es">Aviso legal</span><span class="en">Legal notice</span></a> · <a href="/preservacion.html"><span class="es">Preservación</span><span class="en">Preservation</span></a> · <a href="/privacidad.html"><span class="es">Privacidad</span><span class="en">Privacy</span></a> · <a href="/accesibilidad.html"><span class="es">Accesibilidad</span><span class="en">Accessibility</span></a> · <a href="/cambios.html"><span class="es">Cambios</span><span class="en">Changelog</span></a></span>
      <span class="es">Miembro del programa <a href="https://communitywebs.archive-it.org/organization/4701/" target="_blank" rel="noopener">Community Webs</a> del Internet Archive</span>
      <span class="en">Member of the Internet Archive's <a href="https://communitywebs.archive-it.org/organization/4701/" target="_blank" rel="noopener">Community Webs</a> program</span>
    </div>
  </div>
</footer>

<script src="/assets/site.js?v={{ version }}" defer></script>
{% if esArticulo %}<script type="module" src="/assets/lector.js?v={{ version }}"></script>{% endif %}
</body>
</html>
