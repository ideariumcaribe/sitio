---
layout: base.njk
title: "Catálogo de la Biblioteca Digital · Idearium Caribe"
descripcion: "Catálogo de las obras de la Biblioteca Digital de Idearium Caribe, de libre lectura en línea."
permalink: /biblioteca/catalogo/
---
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Collection","name":"Biblioteca Digital de Idearium Caribe","url":{{ (sitio.url + "/biblioteca/catalogo/") | dump | safe }},"collectionSize":{{ catalogo.length }},"inLanguage":"es","isAccessibleForFree":true,"provider":{"@type":"Organization","name":{{ sitio.nombre | dump | safe }},"url":{{ (sitio.url + "/") | dump | safe }}}}</script>
<main>
  <section class="cat-pag">
    <div class="wrap stack" style="gap:28px">
      <nav class="migas" aria-label="Ruta"><a href="/biblioteca.html"><span class="es">Biblioteca</span><span class="en">Library</span></a><span aria-hidden="true"> › </span><span class="es">Catálogo</span><span class="en">Catalogue</span></nav>
      <div class="sec-title"><div><p class="label es">Biblioteca Digital</p><p class="label en">Digital Library</p>
        <h1 class="es">Catálogo</h1><h1 class="en">Catalogue</h1></div></div>
      {% include "biblioteca-pestanas.njk" %}
      <p class="es cat-intro">Todas las obras se leen en línea, sin costo ni registro. Haga clic en un título para abrirlo.</p>
      <p class="en cat-intro">Every work can be read online, free and without registration. Click a title to open it.</p>
      <div class="cat-buscar">
        <label for="cat-q" class="label"><span class="es">Buscar por título, autor o editorial</span><span class="en">Search by title, author or publisher</span></label>
        <input id="cat-q" type="search" autocomplete="off" spellcheck="false">
        <p class="cat-cuenta" aria-live="polite" data-total="{{ catalogo | length }}"><span class="es">{{ catalogo | length }} obras</span><span class="en">{{ catalogo | length }} works</span></p>
      </div>
      <div class="cat-filtros">
        {%- for idi in ["es", "en"] %}
        <label class="cat-filtro {{ idi }}"><span>{{ "Tema" if idi == "es" else "Subject" }}</span><select data-filtro="tema">
          <option value="">{{ "Todos los temas" if idi == "es" else "All subjects" }}</option>
          {%- for m in materias | sort(false, false, "nombre") %}{% set n = catalogo | cuentaFiltro("materia", m.slug) %}{% if n %}
          <option value="{{ m.slug }}">{{ m.nombre if idi == "es" else (m.nombre_en or m.nombre) }} ({{ n }})</option>{% endif %}{% endfor %}
        </select></label>
        <label class="cat-filtro {{ idi }}"><span>{{ "Década" if idi == "es" else "Decade" }}</span><select data-filtro="decada">
          <option value="">{{ "Todas las décadas" if idi == "es" else "All decades" }}</option>
          {%- for d in catalogo | decadas %}
          <option value="{{ d.d }}">{{ d.d }}{{ "-" if idi == "es" else "s" }}{% if idi == "es" %}{{ (d.d | int) + 9 }}{% endif %} ({{ d.n }})</option>{% endfor %}
        </select></label>
        <label class="cat-filtro {{ idi }}"><span>{{ "Derechos" if idi == "es" else "Rights" }}</span><select data-filtro="derechos">
          <option value="">{{ "Todas las obras" if idi == "es" else "All works" }}</option>
          {%- set etiquetasDer = {"NoC-US": ["Dominio público en EE. UU.", "Public domain in the U.S."], "InC": ["Protegidas por derechos de autor", "In copyright"], "UND": ["Derechos indeterminados", "Copyright undetermined"]} %}
          {%- for k in ["NoC-US", "InC", "UND"] %}{% set n = catalogo | cuentaFiltro("derechos_eeuu", k) %}{% if n %}
          <option value="{{ k }}">{{ etiquetasDer[k][0] if idi == "es" else etiquetasDer[k][1] }} ({{ n }})</option>{% endif %}{% endfor %}
          <option value="autorizada">{{ "Publicadas con autorización del titular" if idi == "es" else "Published with the rights holder's permission" }} ({{ catalogo | cuentaFiltro("autorizada") }})</option>
        </select></label>
        <label class="cat-filtro {{ idi }}"><span>{{ "Lugar de edición" if idi == "es" else "Place of publication" }}</span><select data-filtro="lugar">
          <option value="">{{ "Todos los lugares" if idi == "es" else "All places" }}</option>
          {%- for c in (catalogo | lugares).ciudades %}
          <option value="{{ c.nombre }}">{{ c.nombre }} ({{ c.n }})</option>{% endfor %}
        </select></label>
        {%- endfor %}
        <button type="button" class="cat-limpiar" hidden><span class="es">Quitar filtros</span><span class="en">Clear filters</span></button>
      </div>
      <div class="cat-barra">
      <label class="cat-orden es"><span>Ordenar por</span><select data-orden><option value="signatura">Signatura</option><option value="recientes">Más recientes primero</option><option value="titulo">Título (A–Z)</option><option value="autor">Autor (A–Z)</option><option value="editorial">Editorial (A–Z)</option><option value="anio-asc">Año (más antiguo primero)</option><option value="anio-desc">Año (más reciente primero)</option><option value="lecturas">Más leídas</option></select></label><label class="cat-orden en"><span>Sort by</span><select data-orden><option value="signatura">Call number</option><option value="recientes">Newest additions first</option><option value="titulo">Title (A–Z)</option><option value="autor">Author (A–Z)</option><option value="editorial">Publisher (A–Z)</option><option value="anio-asc">Year (oldest first)</option><option value="anio-desc">Year (newest first)</option><option value="lecturas">Most read</option></select></label>
      <div class="cat-vista" role="group" aria-label="Vista">
        <button type="button" data-vista="portadas" aria-pressed="true"><span class="es">Portadas</span><span class="en">Covers</span></button>
        <button type="button" data-vista="lista" aria-pressed="false"><span class="es">Lista</span><span class="en">List</span></button>
      </div>
      </div>
      {%- set lista = catalogo | sort(false, true, "signatura") %}{% set clase = "cat-portadas" %}{% set oculta = false %}
      {% include "portadas-grid.njk" %}
      <div class="ledger-wrap" hidden>
        <table class="ledger cat-tabla">
          <thead><tr>
            <th><span class="es">Signatura</span><span class="en">Call no.</span></th>
            <th><span class="es">Título</span><span class="en">Title</span></th>
            <th><span class="es">Autor</span><span class="en">Author</span></th>
            <th><span class="es">Año</span><span class="en">Year</span></th>
          </tr></thead>
          <tbody>
            {%- for o in catalogo | sort(false, true, "signatura") %}
            <tr data-buscar="{{ (o.titulo + ' ' + o.autor + ' ' + o.pie_de_imprenta) | sinTildes }}" data-sig="{{ o.signatura }}" data-titulo="{{ o.titulo | claveTitulo }}" data-autor="{{ o.autor | claveAutor }}" data-editorial="{{ o.pie_de_imprenta | claveEditorial }}" data-anio="{{ o.anio }}" data-dec="{{ o.anio | decada }}" data-der="{{ o | derechoCat }}" data-mat="{{ (o.materias or []) | join(' ') }}" data-lugar="{{ o | lugarObra }}" data-lec="{{ o | lecturas }}"><td class="sig">{{ o.signatura }}</td><td><a href="/biblioteca/obras/{{ o.identificador }}/">{{ o.titulo }}</a>{% if o.pie_de_imprenta %}<span class="cat-pie">{{ o.pie_de_imprenta }}</span>{% endif %}</td><td>{% for n in o.autor | split(";") %}<a class="aut" href="/biblioteca/autores/{{ n | slugAutor }}/">{{ n }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td><td class="yr">{{ o.anio }}</td></tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>
      {%- set autorSol = "" %}
      {% include "solicitar.njk" %}
    </div>
  </section>
</main>
<script src="/assets/catalogo.js?v={{ version }}" defer></script>
